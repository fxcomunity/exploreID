# World Monitor — Environment Variables Template
# Salin file ini menjadi .env dan isi dengan key Anda

# MapTiler API Key (Peta / MapLibre GL JS)
VITE_MAPTILER_KEY=your_maptiler_key_here

# ExchangeRate API Key (Nilai tukar mata uang)
VITE_EXCHANGERATE_KEY=your_exchangerate_key_here

# Alpha Vantage API Key (Komoditas, Saham, & Valas)
VITE_ALPHAVANTAGE_KEY=your_alphavantage_key_here
