# World Monitor — Environment Variables Template (Vite)
# Salin file ini menjadi .env dan isi dengan key Anda

# Core Platform
VITE_MAPTILER_KEY=your_maptiler_key_here
VITE_EXCHANGERATE_KEY=your_exchangerate_key_here
VITE_ALPHAVANTAGE_KEY=your_alphavantage_key_here

# Multi-Provider AI (Auto-Failover Backup)
VITE_GEMINI_KEY=your_gemini_key_here
VITE_OPENAI_KEY=your_openai_key_here
VITE_DEEPSEEK_KEY=your_deepseek_key_here
VITE_GROQ_KEY=your_groq_key_here
VITE_MISTRAL_KEY=your_mistral_key_here
VITE_OPENROUTER_KEY=your_openrouter_key_here

# Transport & Radar
VITE_AISSTREAM_KEY=your_aisstream_key_here
VITE_OPENSKY_CLIENT_ID=your_opensky_client_id_here
VITE_OPENSKY_CLIENT_SECRET=your_opensky_client_secret_here
VITE_AVIATIONSTACK_KEY=your_aviationstack_key_here

# Energy & Grid Emissions
VITE_EIA_KEY=your_eia_key_here
VITE_ELECTRICITYMAPS_KEY=your_electricitymaps_key_here
